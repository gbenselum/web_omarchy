post_install() {
  echo "==> web-omarchy installed."
  echo "==> Enable the service to start automatically:"
  echo "==>   systemctl enable --now web-omarchy-daemon.service"

  systemd-sysusers web-omarchy.conf >/dev/null 2>&1 || true
  systemd-tmpfiles --create web-omarchy.conf >/dev/null 2>&1 || true
}

post_upgrade() {
  echo "==> web-omarchy upgraded. Restarting service..."
  systemctl daemon-reload
  systemctl try-restart web-omarchy-daemon.service
}

pre_remove() {
  systemctl stop web-omarchy-daemon.service
  systemctl disable web-omarchy-daemon.service
}

post_remove() {
  systemctl daemon-reload
}